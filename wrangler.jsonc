{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Convención: zyberna-<app>; clientes: client-<nombre>-<web|app>
  "name": "zyberna-internal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  // nodejs_compat: APIs de Node que usan Next.js y @supabase/ssr (Excel se procesa en el navegador).
  // global_fetch_strictly_public: fetch del Worker solo hacia Internet público.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Las variables NEXT_PUBLIC_* se incrustan en el build (públicas, no son secretos).
  // Se pasan al build (CI o .env.local). SITE_URL es de servidor y se lee en runtime.
  "vars": {
    "SITE_URL": "https://os.alvarogaertner.com"
  },
  // Custom Domain: Cloudflare crea el registro DNS de "os" y su certificado. No toca otros registros.
  "routes": [{ "pattern": "os.alvarogaertner.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
